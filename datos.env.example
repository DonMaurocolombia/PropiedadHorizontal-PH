# Servidor: inicializa PostgreSQL en ./postgres-data y escucha en el puerto 5433.
DB_MODE=server
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=admin_ph
DB_USER=admin_ph
DB_PASSWORD=replace-with-a-strong-password
DB_SSLMODE=prefer

# Para permitir clientes remotos, configura ambas variables con redes privadas
# confiables. Los valores predeterminados limitan el acceso a esta máquina.
DB_LISTEN_ADDRESSES=127.0.0.1,::1
DB_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# Opcional: directorio que contiene initdb, pg_ctl y pg_dump.
# DB_BIN_DIR=/ruta/a/postgresql/bin
